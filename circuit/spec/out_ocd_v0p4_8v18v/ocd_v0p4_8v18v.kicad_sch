	(title_block
		(title "ocd_v0p4_8v18v")
		(date "2026-11-11")
		(comment 1 "OCD-style overdrive v0.4: S002-verified topology + user node connections; 8-18V DC center-negative, 9V nominal. D_FB_FIX moves C4/C8 in series with R5/R11 (the prior parallel placement saturated both op-amps). Adds 1N5819 protection, status LED, 9V battery/DC-jack provision, and an explicit HP/LP SW1. Not a verified Fulltone netlist; 2N7000/1N34A/1N5819 models are approximations.")
	)
