(export (version "E")
	(design
		(source "ocd_v0p4_8v18v.kicad_sch")
		(date "2026-11-11")
		(tool "circuit-design-skill")
	)
	(components
		(comp (ref "V1") (value "9 V") (footprint "") (description "9V nominal test at the DC jack; design range 8-18V DC center-negative (C022). D_PWR and R1 drop before the op-amp rail."))
		(comp (ref "V_IN") (value "SIN source") (footprint "") (description "Transient excitation 50mVpk/1kHz. AC excitation is V_AC because the generator drops AC when a waveform is present."))
		(comp (ref "V_AC") (value "0 V") (footprint "") (description "AC excitation 1V for .ac/.noise. Simulation-only; in series with V_IN. Workaround for the generator dropping AC on a waveform source."))
		(comp (ref "D_PWR") (value "APPROX_1N5819") (footprint "") (description "Series Schottky reverse-polarity protection; 1N5819 default. APPROX model; Vf ~0.25-0.3V. 8V-jack margin to the TL082 7V minimum is a bench gate (D_PROT)."))
		(comp (ref "R1") (value "100") (footprint "") (description "S002-schematic-image-confirmed: supply feed/filter node (R1=100ohm), now after D_PWR protection."))
		(comp (ref "C2") (value "10u") (footprint "") (description "S002-schematic-image-confirmed: power bulk filter (C2=10µF)."))
		(comp (ref "C3") (value "100n") (footprint "") (description "S002-schematic-image-confirmed: power HF decoupling (C3=100nF)."))
		(comp (ref "R4") (value "10k") (footprint "") (description "S002-schematic-image-confirmed: Vref divider upper (R4=10k)."))
		(comp (ref "R7") (value "10k") (footprint "") (description "S002-schematic-image-confirmed: Vref divider lower (R7=10k)."))
		(comp (ref "C5") (value "10u") (footprint "") (description "S002-schematic-image-confirmed: Vref filter cap (C5=10µF)."))
		(comp (ref "C1") (value "22n") (footprint "") (description "S002-schematic-image-confirmed: input coupling cap (C1=22nF)."))
		(comp (ref "R2") (value "1Meg") (footprint "") (description "S002-schematic-image-confirmed: R2 (1M) connects input cap C1 to GROUND as voltage reference, not to VREF. R6 biases op-amp to VREF."))
		(comp (ref "R6") (value "470k") (footprint "") (description "S002-schematic-image-confirmed: biases op-amp non-inverting input to VREF (R6=470k)."))
		(comp (ref "R3") (value "10k") (footprint "") (description "S002-schematic-image-confirmed: limits current to op-amp input (R3=10k)."))
		(comp (ref "X1A") (value "TL082") (footprint "") (description "TL082 section 1; wiring assumed"))
		(comp (ref "R5") (value "2.2k") (footprint "") (description "S002-confirmed value R5=2.2k. D_FB_FIX: R5 is in series with C4 to VREF so the stage has unity DC gain and an AC bass limit."))
		(comp (ref "R8") (value "18k") (footprint "") (description "S002-schematic-image-confirmed: gain network (R8=18k)."))
		(comp (ref "R_X2POT") (value "500k") (footprint "") (description "Drive/gain pot modeled 50% of 1M (S002 states gain pot 1M; mapping/wiring assumed)."))
		(comp (ref "C4") (value "100n") (footprint "") (description "S002-confirmed C4=100nF. D_FB_FIX: C4 is in series with R5, not in parallel with it; the parallel placement had zero DC feedback and saturated X1."))
		(comp (ref "C6") (value "220p") (footprint "") (description "S002-schematic-image-confirmed: HF stability cap (C6=220pF)."))
		(comp (ref "R9") (value "10k") (footprint "") (description "S002-schematic-image-confirmed: series into clipping (R9=10k)."))
		(comp (ref "C7") (value "10n") (footprint "") (description "S002-schematic-image-confirmed: VREF-CLIP_A cap (C7=10nF)."))
		(comp (ref "R10") (value "10k") (footprint "") (description "S002-schematic-image-confirmed: clip network resistor (R10=10k)."))
		(comp (ref "R12") (value "220k") (footprint "") (description "S002-schematic-image-confirmed: bias to CLIP_B (R12=220k)."))
		(comp (ref "M1") (value "APPROX_2N7000") (footprint "") (description "S002-schematic-image-confirmed: M1 [D&G=VREF, S=CLIP_A]. Exact part unknown; APPROX sim-only. Commenter-reported alternate wiring (M1[S=VREF,D&G=R9/R10]) does NOT match S002 image."))
		(comp (ref "M2") (value "APPROX_2N7000") (footprint "") (description "S002-schematic-image-confirmed: M2 [D=VREF, G&S=M2_D1_NODE]. Exact part unknown; APPROX sim-only. Commenter-reported alternate wiring (M2[D&G=VREF,S=D1]) does NOT match S002 image."))
		(comp (ref "D1") (value "APPROX_1N34A") (footprint "") (description "S002-schematic-image-confirmed: D1 [A=CLIP_A, K=M2_D1_NODE], 1N34A Ge per article text (C027). APPROX sim-only model, Ge variability applies."))
		(comp (ref "X3A") (value "TL082") (footprint "") (description "S002-schematic-image-confirmed: TL082 section 2; non-inv input CLIP_B; wiring assumed."))
		(comp (ref "R11") (value "39k") (footprint "") (description "S002-confirmed R11=39k. D_FB_FIX: R11 is in series with C8 to VREF so the stage has unity DC gain."))
		(comp (ref "R13") (value "150k") (footprint "") (description "S002-schematic-image-confirmed: feedback (R13=150k)."))
		(comp (ref "C8") (value "100n") (footprint "") (description "S002-confirmed C8=100nF. D_FB_FIX: C8 is in series with R11, not in parallel with it; the parallel placement had zero DC feedback and saturated X3."))
		(comp (ref "C9") (value "220p") (footprint "") (description "S002-schematic-image-confirmed: HF stability (C9=220pF)."))
		(comp (ref "C10") (value "10u") (footprint "") (description "S002-schematic-image-confirmed: output coupling cap (C10=10µF)."))
		(comp (ref "R_X4") (value "5k") (footprint "") (description "S002 tone pot X4=10k wired as a rheostat in series with C11 to ground (treble passes through X4 then C11). 50% snapshot=5k; BOM part is a 10k pot."))
		(comp (ref "C11") (value "47n") (footprint "") (description "S002-schematic-image-confirmed: tone cap C11 to ground (C11=47nF)."))
		(comp (ref "R14") (value "22k") (footprint "") (description "S002-confirmed R14=22k. Main signal path from TONE_TOP (after C10) to VOL_TOP; always in circuit (LP=open, darker)."))
		(comp (ref "R15") (value "33k") (footprint "") (description "S002-confirmed R15=33k. Switched in parallel with R14 via SW1 from TONE_TOP to VOL_TOP; HP=closed/parallel=brighter (S003), LP=open/darker."))
		(comp (ref "SW1") (value "SW1MODEL") (footprint "") (description "HP/LP toggle modeled as a voltage-controlled switch. HP = closed (V_HP=5V) -> R15 parallel with R14 (brighter); LP = open (V_HP=0V) -> R14 only (darker). Physical part is an SPDT; PCB pad mapping is Phase C."))
		(comp (ref "V_HP") (value "5 V") (footprint "") (description "Simulation-only switch control. 5V = HP (SW1 closed, parallel, brighter); change to 0V for the LP variant."))
		(comp (ref "R_VOL5A") (value "50k") (footprint "") (description "Volume pot 100k modeled at 50% (X5 value not found in retrieved S002 text; 100k is placeholder)."))
		(comp (ref "R_VOL5B") (value "50k") (footprint "") (description "Volume pot lower leg modeled at 50% (X5 value not found in retrieved S002 text; 100k is placeholder)."))
		(comp (ref "R_LOAD") (value "100k") (footprint "") (description ""))
		(comp (ref "R_LED") (value "4.7k") (footprint "") (description "Status LED series resistor; 1.35mA at 9V, ~3mA at 18V (Vf 1.8V). Physical LED switching is via the 3PDT (D_LED)."))
		(comp (ref "D_LED") (value "LED_RED") (footprint "") (description "Status LED, 1.8V red generic model. Always-on in simulation; physically switched by the 3PDT."))
	)
	(nets
		(net (code "1") (name "GND")
			(node (ref "C11") (pin "2"))
			(node (ref "C2") (pin "2"))
