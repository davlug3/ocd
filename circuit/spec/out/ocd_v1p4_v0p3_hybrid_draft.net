		(comp (ref "Q2") (value "APPROX_2N7000") (footprint "") (description "PROVISIONAL WIRING (conflict). VERIFY orientation."))
		(comp (ref "D_ASYM") (value "APPROX_BAT46") (footprint "") (description "PROVISIONAL asymmetry element (D003 default BAT46; Ge/1N4148 options). VERIFY orientation/polarity with chosen wiring."))
